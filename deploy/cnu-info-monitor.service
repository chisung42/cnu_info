[Unit]
Description=CNU Info notice crawler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=moon
Group=moon
WorkingDirectory=/srv/cnuinfo
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/cnuinfo/.venv/bin/python /srv/cnuinfo/scripts/monitor_new_notices.py --interval 60 --attachments-dir /srv/cnuinfo/attachments --data-dir /srv/cnuinfo/data --max-images 20 --workers 4
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
